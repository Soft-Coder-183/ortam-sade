<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ortam Sade masaüstü penceresi: tek pencere, siyah konsol yok, sistem tepsisi simgesi. .NET Framework 4.8 her Windows 10/11'de
       hazır gelir; görüntüleme için Windows'taki Edge WebView2 kullanılır. Derleme: dotnet publish masaustu -c Release -o <klasör> -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OrtamSade</AssemblyName>
    <RootNamespace>OrtamSade</RootNamespace>
    <ApplicationIcon>..\kurulum\simge.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Ortam Sade</Product>
    <Description>Ortam Sade</Description>
    <Company>Ortam Sade (bağımsız öğrenci projesi)</Company>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <EmbeddedResource Include="..\kurulum\simge.ico" LogicalName="simge.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
